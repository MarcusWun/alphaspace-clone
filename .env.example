# ============================================================
# Alpha — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ---- Finnhub (server-side only — never expose to client) ---
FINNHUB_API_KEY=your_finnhub_api_key_here

# ---- Benzinga (Phase 2) ------------------------------------
BENZINGA_API_KEY=your_benzinga_api_key_here

# ---- AI — Local (Ollama) -----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b

# ---- AI — Cloud (Anthropic) --------------------------------
# Leave unset to disable cloud escalation
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Auth.js v5 --------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_32plus_byte_random_secret_here
# Public URL of the app (used for Auth.js OAuth callbacks)
AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true  # required when Auth.js runs behind a reverse proxy (e.g. Nginx on Geekom A9)

# ---- Email magic-link (SMTP) --------------------------------
# e.g. smtps://user:pass@smtp.example.com:465
AUTH_EMAIL_SERVER=smtps://user:password@smtp.example.com:465
AUTH_EMAIL_FROM=noreply@example.com

# ---- OAuth providers (optional — omit to disable) ----------
AUTH_GITHUB_ID=your_github_oauth_app_client_id
AUTH_GITHUB_SECRET=your_github_oauth_app_client_secret
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# ---- Database ----------------------------------------------
# Used by Prisma (apps/api and packages/db)
DATABASE_URL=postgresql://alpha:alpha@localhost:5432/alpha

# ---- Redis -------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- API URL (public — safe for client bundles) ------------
# Points browsers at the Fastify API
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Frontend OAuth visibility flags (set to "true" when providers are configured) ----
# Controls whether GitHub/Google buttons appear on the sign-in page
NEXT_PUBLIC_HAS_GITHUB=false
NEXT_PUBLIC_HAS_GOOGLE=false

# ---- Rate limiting (tunable) --------------------------------
# Max API requests per user per minute
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
